{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "System Auditor: Console report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/system_auditor_cli.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["${input:auditFile}"]
        },
        {
            "name": "System Auditor: Save JSON report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/system_auditor_cli.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["${input:auditFile}", "${input:reportFile}"]
        }
    ],
    "inputs": [
        {
            "id": "auditFile",
            "type": "promptString",
            "description": "Input audit definition JSON file",
            "default": "audit_host_baseline.json"
        },
        {
            "id": "reportFile",
            "type": "promptString",
            "description": "Output report JSON file",
            "default": "report.json"
        }
    ]
}
